# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# Never commit .env or .env.local to GitHub.
# ==============================================================================

# Database Configuration
DATABASE_URL="your-database-connection-string"
MONGODB_URI="your-mongodb-uri"

# Cloudinary & CDN Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_BASE_URL="https://res.cloudinary.com/your-cloud-name/image/upload"

# Artwork CDN Asset URLs
NEXT_PUBLIC_ARTWORK_1_URL="https://res.cloudinary.com/.../art1.jpg"
